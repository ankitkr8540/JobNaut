# Copy to .env; NEVER COMMIT .env or real credentials
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
APP_SECRET_KEY=
DATABASE_URL=postgresql+psycopg://jobagent:jobagent_local_only@localhost:5432/jobagent

# Models: configure at least one for LLM-based features
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
EMBEDDINGS_PROVIDER=openai
EMBEDDING_MODEL=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=job-search-agent

# Google OAuth: configure in Google Cloud Console
GOOGLE_ACCOUNT_EMAIL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
GMAIL_READONLY_ENABLED=false
GMAIL_POLL_INTERVAL_MINUTES=10
GOOGLE_CALENDAR_ENABLED=false

# Browser; sessions and passwords are stored in a SEPARATE encrypted vault
BROWSER_HEADLESS=false
BROWSER_PROFILE_DIR=.private/browser-profiles
BROWSER_SESSION_DIR=.private/sessions
ENABLE_BROWSER_USE=false
BROWSER_USE_MODEL=
SITE_ALLOWLIST=
BROWSER_ACTION_LIMIT=40
OTP_WAIT_TIMEOUT_SECONDS=120
OTP_POLL_SECONDS=5

# Vault backend choices: keyring, encrypted-file. Never store site passwords here.
CREDENTIAL_VAULT_BACKEND=keyring
ENCRYPTION_KEY_REF=jobagent/session-key

# Review and policy. Backend always enforces irreversible action approval.
APPROVAL_REQUIRED_FOR_SUBMIT=true
ALLOW_SEND_EMAIL=false
ALLOW_ACCOUNT_CREATION=true
PREFER_GOOGLE_SIGNIN=true
REQUIRE_MANUAL_GOOGLE_SECURITY_CHALLENGES=true
JOB_DISCOVERY_INTERVAL_MINUTES=60
JOB_MATCH_SCORE_THRESHOLD=75
JOB_DISCOVERY_MOCK_MODE=true
EMAIL_MOCK_MODE=true
BROWSER_MOCK_MODE=true

# Optional cloud integrations (unused in local-first MVP)
AWS_REGION=
AWS_S3_BUCKET=
REDIS_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
